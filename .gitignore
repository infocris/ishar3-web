!/run-web.sh
!/run-web-jsdos.sh
!/run-alis-native.sh
!/run-dosbox.sh
!/dosbox-mac.conf
!/web/
/web/*
!/web/serve.py
!/web/index.html
!/web/dosbox.html
!/web/dosbox.conf
!/web/build-bundle.sh
!/web/package.json
!/web/package-lock.json
!/web/alis/
.DS_Store
