+                return 0;   // menu disque : nom de sauvegarde
+        }
+        zqsd_held[dir] = 1;
+    }
+    else
+    {
+        if (!zqsd_held[dir])
+            return 0;       // appui laissé en lettre : relâchement en lettre aussi
+        zqsd_held[dir] = 0;
+    }
+    ks->sym = zqsd_sym[dir];
+    ks->scancode = zqsd_sc[dir];
+    return 1;
