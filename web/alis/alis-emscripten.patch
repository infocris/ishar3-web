+int sys_zqsd_remap(SDL_Keysym *ks, int down)
+{
+    int dir;
+    switch (ks->sym)
+    {
+        case SDLK_z: dir = 0; break;
+        case SDLK_s: dir = 1; break;
+        case SDLK_q: dir = 2; break;
+        case SDLK_d: dir = 3; break;
